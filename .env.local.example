# Supabase (local: from `supabase status`; hosted: from `supabase projects api-keys`)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Anthropic
ANTHROPIC_API_KEY=
PARSE_MODEL=claude-sonnet-5-5

# Mail adapter: noop is the only Phase 1 adapter
MAIL_ADAPTER=noop

# Seed user (scripts/seed.ts creates this login)
SEED_USER_EMAIL=michael@example.com
SEED_USER_PASSWORD=change-me-before-demo
